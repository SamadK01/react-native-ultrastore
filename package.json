{
  "name": "react-native-ultrastore",
  "version": "2.4.0",
  "description": "Ultra-fast synchronous storage, state manager & on-device AI edge-cache for React Native (MMKV v4, Nitro Modules, New Architecture).",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js"
    },
    "./zustand": {
      "types": "./lib/typescript/zustand.d.ts",
      "import": "./lib/module/zustand.js",
      "require": "./lib/commonjs/zustand.js"
    },
    "./query": {
      "types": "./lib/typescript/hooks/useUltraQuery.d.ts",
      "import": "./lib/module/hooks/useUltraQuery.js",
      "require": "./lib/commonjs/hooks/useUltraQuery.js"
    },
    "./atom": {
      "types": "./lib/typescript/atom.d.ts",
      "import": "./lib/module/atom.js",
      "require": "./lib/commonjs/atom.js"
    },
    "./ai": {
      "types": "./lib/typescript/ai/index.d.ts",
      "import": "./lib/module/ai/index.js",
      "require": "./lib/commonjs/ai/index.js"
    }
  },
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "expo": {
    "install": {
      "exclude": ["react-native-mmkv"]
    }
  },
  "expoPlugin": "./plugin/index.js",
  "codegenConfig": {
    "name": "RNUltraStoreSpec",
    "type": "modules",
    "jsSrcsDir": "src"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "rm -rf lib",
    "build": "bob build && del-cli 'lib/**/*.map'",
    "prepare": "npm run build",
    "release": "npm publish",
    "example": "yarn workspace react-native-ultrastore-example",
    "bootstrap": "yarn install && yarn example && yarn install --cwd example && cd example/ios && pod install"
  },
  "keywords": [
    "react-native",
    "storage",
    "state-management",
    "MMKV",
    "asyncstorage-alternative",
    "redux-alternative",
    "hooks",
    "typescript",
    "persist",
    "fast",
    "ultrastore",
    "zustand-alternative",
    "encryption",
    "namespaces",
    "middleware",
    "query-cache",
    "offline-first",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamadK01/react-native-ultrastore.git"
  },
  "author": "Samad Khalid",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SamadK01/react-native-ultrastore/issues"
  },
  "homepage": "https://github.com/SamadK01/react-native-ultrastore#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@babel/plugin-transform-flow-strip-types": "^7.27.1",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-typescript": "^7.28.5",
    "@react-native-community/bob": "^0.17.1",
    "@react-native/eslint-config": "^0.74.0",
    "@release-it/conventional-changelog": "^8.0.1",
    "@types/jest": "^29.5.12",
    "@types/react": "^18.3.26",
    "@types/react-native": "^0.72.8",
    "del-cli": "^5.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "react": "18.2.0",
    "react-native": "0.74.1",
    "react-native-builder-bob": "^0.23.2",
    "release-it": "^17.2.1",
    "ts-jest": "^29.4.9",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.75.0",
    "react-native-mmkv": ">=4.0.0",
    "react-native-nitro-modules": ">=0.35.0"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    }
  },
  "dependencies": {},
  "eslintConfig": {
    "root": true,
    "extends": [
      "@react-native",
      "prettier"
    ],
    "rules": {
      "prettier/prettier": [
        "error",
        {
          "quoteProps": "consistent",
          "singleQuote": true,
          "tabWidth": 2,
          "trailingComma": "es5",
          "useTabs": false
        }
      ]
    }
  },
  "eslintIgnore": [
    "node_modules/",
    "lib/"
  ],
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module"
    ],
    "config": "bob.config.js"
  }
}
